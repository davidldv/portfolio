---
import { ui, type Lang } from '../../i18n/ui';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].about;
---

<section id="about" class="relative z-2 px-6 py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeader index="02" label={t.eyebrow} heading={t.heading} class="mb-14" />

    <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-[280px_1fr] md:gap-16 lg:grid-cols-[320px_1fr] lg:gap-20">
      <div class="about-portrait reveal flex justify-center">
        <div class="portrait-frame relative w-full max-w-75 overflow-hidden rounded-2xl bg-[#050506]">
          <img
            src="/david.jpg"
            alt={t.portraitAlt}
            width="400"
            height="500"
            loading="lazy"
            decoding="async"
            class="relative z-1 block h-auto w-full mix-blend-lighten mask-[linear-gradient(to_bottom,black_65%,transparent_100%)]"
          />
          <div class="portrait-glow absolute inset-0 z-0 blur-3xl [background:radial-gradient(ellipse_70%_60%_at_50%_40%,var(--accent-glow),transparent_70%)]" aria-hidden="true"></div>
        </div>
      </div>

      <div class="about-right flex flex-col gap-12">
        <div class="about-bio reveal">
          <p class="mb-5 text-[1.05rem] leading-[1.8] text-fg-muted">{t.p1}</p>
          <p class="mb-5 text-[1.05rem] leading-[1.8] text-fg-muted">{t.p2}</p>
          <p class="mb-5 text-[1.05rem] leading-[1.8] text-fg-muted">{t.p3}</p>
          <p class="mb-7 text-[1.05rem] leading-[1.8] text-fg-muted">{t.p4}</p>

          <div class="bio-meta flex flex-wrap items-center gap-2">
            <div class="bio-location inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3.5 py-1.5 font-mono text-[0.85rem] text-fg-muted">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 13-8 13s-8-7-8-13a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              {t.location}
            </div>
          </div>
        </div>

        <!-- Ruled key/values instead of four more bordered boxes. -->
        <dl class="about-stats reveal m-0 grid grid-cols-2 gap-x-8 gap-y-7 sm:grid-cols-4">
          {t.stats.map(({ value, label }) => (
            <div class="flex flex-col gap-2 border-t border-border pt-4">
              <dt class="order-2 text-[0.78rem] font-medium text-fg-muted">{label}</dt>
              <dd class="order-1 m-0 font-mono text-[clamp(1.15rem,2.1vw,1.5rem)] font-semibold leading-tight tracking-[-0.03em] text-fg">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
