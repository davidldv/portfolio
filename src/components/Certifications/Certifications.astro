---
import { ui, type Lang } from '../../i18n/ui';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].certs;

type Cert = {
  name: string;
  issuer: string;
  status: 'completed' | 'in-progress' | 'planned';
  target: string;
  /** Indicative completion 0..1 for in-progress items; 1 for completed, 0 for planned. */
  progress: number;
};

const certs: Cert[] = [
  {
    name: 'Google Professional Cybersecurity Certificate',
    issuer: 'Google · Coursera',
    status: 'completed',
    target: '2026',
    progress: 1,
  },
  {
    name: 'PortSwigger Web Security Academy',
    issuer: 'PortSwigger',
    status: 'completed',
    target: 'All free courses',
    progress: 1,
  },
  {
    name: 'Burp Suite Certified Practitioner',
    issuer: 'PortSwigger',
    status: 'in-progress',
    target: '2026 Q4',
    progress: 0.65,
  },
];

const statusLabel = (s: Cert['status']) =>
  s === 'completed' ? t.completed : s === 'in-progress' ? t.inProgress : t.planned;

const railColor = (s: Cert['status']) =>
  s === 'completed' ? 'bg-accent' : s === 'in-progress' ? 'bg-accent-secondary' : 'bg-border';
---

<section id="certifications" class="relative z-2 px-6 py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeader index="03" label={t.eyebrow} heading={t.heading} intro={t.intro} class="mb-14" />

    <!-- A status table, not a trophy shelf: same rule language as the rest of
         the page, with the progress rail doing the ranking work. -->
    <ul class="reveal m-0 flex list-none flex-col border-t border-border p-0" role="list">
      {certs.map((cert) => (
        <li class="group grid grid-cols-1 items-center gap-x-10 gap-y-4 border-b border-border py-6 md:grid-cols-[1fr_10rem_11rem]">
          <div class="flex items-start gap-3.5">
            <span class={`mt-0.5 shrink-0 ${cert.status === 'planned' ? 'text-fg-muted' : 'text-accent'}`} aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/>
                <path d="M9 12l2 2 4-4"/>
              </svg>
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="m-0 text-[1.02rem] font-semibold leading-[1.35] tracking-[-0.01em] text-fg">{cert.name}</h3>
              <p class="m-0 text-[0.84rem] text-fg-muted">{cert.issuer}</p>
            </div>
          </div>

          <div class="h-[3px] w-full max-w-44 bg-border md:max-w-none" role="presentation">
            <div
              class={`h-full transition-[width] duration-700 ease-out ${railColor(cert.status)}`}
              style={`width:${Math.round(cert.progress * 100)}%`}
            ></div>
          </div>

          <div class="flex flex-col gap-0.5 font-mono text-[0.76rem] md:items-end md:text-right">
            <span class={cert.status === 'in-progress' ? 'text-accent-secondary' : 'text-fg-muted'}>
              {statusLabel(cert.status)}
            </span>
            <span class="text-fg">{cert.target}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
