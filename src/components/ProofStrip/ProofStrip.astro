---
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].proof;

// Hrefs + icon keys are language-neutral; merged by index with the i18n items.
const links: { href: string; external: boolean; icon: 'lab' | 'cli' | 'doc' }[] = [
  { href: 'https://github.com/davidldv/jwtsecuritylab', external: true, icon: 'lab' },
  { href: 'https://www.npmjs.com/package/jwt-scan', external: true, icon: 'cli' },
  { href: '/writeups/', external: false, icon: 'doc' },
];

const items = t.items.map((item, i) => ({ ...item, ...links[i] }));
---

<section id="proof" class="relative z-2 px-6 pt-10 pb-6">
  <div class="reveal mx-auto max-w-7xl">
    <div class="rounded-[24px] border border-border bg-surface-elevated p-6 sm:p-8">
      <p class="mb-6 flex items-stretch gap-4 text-[1rem] leading-[1.7] text-fg-muted sm:text-[1.05rem]">
        <span class="w-[2px] shrink-0 bg-accent-secondary" aria-hidden="true"></span>
        <span class="max-w-3xl">{t.lead}</span>
      </p>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {items.map(({ title, desc, href, external, icon }) => (
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="proof-item group relative flex flex-col gap-2 overflow-hidden rounded-2xl border border-border bg-surface p-5 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-border"
          >
            <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 [background:radial-gradient(ellipse_80%_60%_at_50%_0%,var(--accent-glow),transparent)] group-hover:opacity-100"></div>
            <div class="relative z-1 flex items-center justify-between gap-2">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-surface-elevated text-accent" aria-hidden="true">
                {icon === 'lab' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 3h6M10 3v6.5L5 19a1 1 0 0 0 .9 1.5h12.2A1 1 0 0 0 19 19l-5-9.5V3"/>
                  </svg>
                )}
                {icon === 'cli' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m4 17 6-6-6-6M12 19h8"/>
                  </svg>
                )}
                {icon === 'doc' && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 3v4a1 1 0 0 0 1 1h4"/>
                    <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/>
                    <path d="M9 13h6M9 17h4"/>
                  </svg>
                )}
                <span class="sr-only">{title}</span>
              </span>
              <svg class="text-fg-muted transition-colors duration-150 group-hover:text-accent-secondary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {external
                  ? <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  : <path d="M5 12h14M12 5l7 7-7 7"/>}
              </svg>
            </div>
            <h3 class="relative z-1 m-0 font-mono text-[0.92rem] font-semibold tracking-[-0.01em] text-fg">{title}</h3>
            <p class="relative z-1 m-0 text-[0.84rem] leading-[1.6] text-fg-muted">{desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
