---
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].proof;

// Hrefs + icon keys are language-neutral; merged by index with the i18n items.
const links: { href: string; external: boolean; icon: 'lab' | 'cli' | 'doc' }[] = [
  { href: 'https://github.com/davidldv/jwtsecuritylab', external: true, icon: 'lab' },
  { href: 'https://www.npmjs.com/package/jwt-scan', external: true, icon: 'cli' },
  { href: '/writeups/', external: false, icon: 'doc' },
];

const items = t.items.map((item, i) => ({ ...item, ...links[i] }));
---

<section id="proof" class="relative z-2 px-6 pt-12 pb-8">
  <div class="reveal mx-auto max-w-7xl">
    <p class="mb-10 flex items-stretch gap-5 text-[1.05rem] leading-[1.7] text-fg-muted sm:text-[1.1rem]">
      <span class="w-[2px] shrink-0 bg-accent-secondary" aria-hidden="true"></span>
      <span class="max-w-3xl text-balance">{t.lead}</span>
    </p>

    <!-- Rule-separated row, not cards: the hairlines carry the structure so the
         eye reads three peers instead of three competing boxes. -->
    <div class="grid grid-cols-1 divide-y divide-border border-y border-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {items.map(({ title, desc, href, external, icon }) => (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          class="proof-item group relative flex flex-col gap-2 px-0 py-6 no-underline sm:px-7 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <!-- Accent bar wipes across the item's own rule on hover. -->
          <span class="pointer-events-none absolute inset-x-0 -top-px h-px origin-left scale-x-0 bg-accent transition-transform duration-300 ease-out group-hover:scale-x-100 sm:inset-x-0" aria-hidden="true"></span>

          <div class="flex items-center gap-2.5">
            <span class="text-accent transition-colors duration-200" aria-hidden="true">
              {icon === 'lab' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 3h6M10 3v6.5L5 19a1 1 0 0 0 .9 1.5h12.2A1 1 0 0 0 19 19l-5-9.5V3"/>
                </svg>
              )}
              {icon === 'cli' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m4 17 6-6-6-6M12 19h8"/>
                </svg>
              )}
              {icon === 'doc' && (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3v4a1 1 0 0 0 1 1h4"/>
                  <path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/>
                  <path d="M9 13h6M9 17h4"/>
                </svg>
              )}
            </span>

            <h3 class="m-0 text-[0.98rem] font-semibold tracking-[-0.01em] text-fg">{title}</h3>

            <svg class="ml-auto shrink-0 text-fg-muted/60 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-accent" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {external
                ? <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                : <path d="M5 12h14M12 5l7 7-7 7"/>}
            </svg>
          </div>

          <p class="m-0 text-[0.86rem] leading-[1.65] text-fg-muted">{desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
