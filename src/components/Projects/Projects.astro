---
import { ui, type Lang } from '../../i18n/ui';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].projects;

interface Project {
  id: keyof typeof t.items;
  name: string;
  tags: string[];
  href: string | null;
  playable?: boolean;
}

const baseProjects: Project[] = [
  {
    id: 'authzscan',
    name: 'authzscan',
    tags: ['TypeScript', 'Claude agents', 'ts-morph', 'Next.js', 'IDOR/BOLA', 'SARIF'],
    href: 'https://github.com/davidldv/authzscan',
  },
  {
    id: 'paircode',
    name: 'PairCode',
    tags: ['Next.js', 'PostgreSQL', 'EdDSA', 'Argon2id', 'RBAC', 'WebSockets'],
    href: 'https://paircode-lime.vercel.app/',
  },
  {
    id: 'jwt-lab',
    name: 'JWT Security Lab',
    tags: ['TypeScript', 'Node.js', 'Docker', 'JWT', 'OpenSSL', 'Bash'],
    href: 'https://github.com/davidldv/jwtsecuritylab',
  },
  {
    id: 'llmseclab',
    name: 'LLM/RAG Security Lab',
    tags: ['Python', 'FastAPI', 'RAG', 'Prompt Injection', 'MCP', 'OWASP LLM Top 10'],
    href: 'https://github.com/davidldv/llmseclab',
  },
  {
    id: 'ctf',
    name: 'Exploit the Box',
    tags: ['React', 'TypeScript', 'SQLi', 'IDOR', 'JWT', 'XSS'],
    href: '/ctf',
    playable: true,
  },
  {
    id: 'la-bodega',
    name: 'Materiales La Bodega',
    tags: ['Next.js', 'PostgreSQL', 'Mercado Pago', 'OWASP', 'RBAC', 'CSRF'],
    href: 'https://materialeslabodega.com.co',
  },
];

const projects = baseProjects.map((p) => {
  const content = t.items[p.id];
  return { ...p, ...content };
});
---

<section id="projects" class="relative z-2 px-6 py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeader index="05" label={t.eyebrow} heading={t.heading} class="mb-14" />

    <!-- ponytail: CSS columns masonry — cards pack vertically, no row stretching.
         Reading order goes down column 1 then column 2, not left-to-right. -->
    <div class="gap-6 md:columns-2">
      {projects.map(({ name, tagline, description, highlights, tags, href, playable }) => {
        const isInternal = !!href && href.startsWith('/');
        return (
        <article class="group reveal relative mb-6 block break-inside-avoid cursor-pointer overflow-hidden rounded-2xl border border-border bg-surface-elevated transition-colors duration-200 hover:border-accent-border">
          <!-- Top rule wipes to accent on hover — same gesture as the proof strip. -->
          <span class={`pointer-events-none absolute inset-x-0 top-0 h-[2px] origin-left bg-accent transition-transform duration-400 ease-out ${playable ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'}`} aria-hidden="true"></span>
          <div class="relative z-1 flex flex-col gap-3 p-8">
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-center gap-2.5">
                <h3 class="m-0 text-[1.15rem] font-bold tracking-[-0.02em] text-fg">{name}</h3>
                {playable && href && (
                  <a href={href} class="relative z-3 inline-flex items-center gap-1 font-mono text-[0.72rem] font-medium text-accent underline decoration-accent/40 underline-offset-4 transition-colors duration-150 hover:decoration-accent">
                    {t.play}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </a>
                )}
              </div>
              {href && (
                <a href={href} target={isInternal ? undefined : '_blank'} rel={isInternal ? undefined : 'noopener noreferrer'} class="mt-0.5 shrink-0 text-fg-muted transition-colors duration-150 hover:text-accent-secondary" aria-label={`${isInternal ? t.play : t.visit} ${name}`}>
                  {isInternal ? (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="6 3 20 12 6 21 6 3"/>
                    </svg>
                  ) : (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    </svg>
                  )}
                </a>
              )}
            </div>
            <p class="m-0 font-mono text-[0.82rem] font-medium text-accent">{tagline}</p>
            <p class="m-0 text-[0.9rem] leading-[1.7] text-fg-muted">{description}</p>
            {highlights && highlights.length > 0 && (
              <ul class="m-0 flex list-none flex-col gap-1.5 border-l border-border pl-4">
                {highlights.map((item) => (
                  <li class="flex items-baseline gap-2 text-[0.8rem] leading-[1.6] text-fg-muted">
                    <span class="font-mono text-[0.72rem] text-accent" aria-hidden="true">→</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-2 flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <span class="rounded-full border border-border bg-surface px-2.5 py-1 text-[0.72rem] text-fg-muted">{tag}</span>
              ))}
            </div>
          </div>
          {isInternal && href && (
            <a href={href} class="absolute inset-0 z-2" aria-label={`${t.play} ${name}`}></a>
          )}
        </article>
        );
      })}
    </div>
  </div>
</section>
