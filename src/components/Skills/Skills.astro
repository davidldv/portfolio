---
import { ui, type Lang } from '../../i18n/ui';
import { SkillsInteractive } from './SkillsInteractive';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].skills;
---

<section id="skills" class="relative z-2 px-6 py-28">
  <div class="mx-auto max-w-7xl">
    <div class="reveal mb-14">
      <Eyebrow index="04" label={t.eyebrow} class="mb-3" />
      <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-bold tracking-[-0.04em] text-fg">{t.heading}</h2>
    </div>

    <SkillsInteractive client:visible categoryNames={t.categories} />
  </div>
</section>
