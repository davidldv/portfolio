---
import { ui, type Lang } from '../../i18n/ui';
import { SkillsInteractive } from './SkillsInteractive';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].skills;
---

<section id="skills" class="relative z-2 px-6 py-24">
  <div class="mx-auto max-w-7xl">
    <SectionHeader index="04" label={t.eyebrow} heading={t.heading} class="mb-14" />

    <SkillsInteractive client:visible categoryNames={t.categories} />
  </div>
</section>
