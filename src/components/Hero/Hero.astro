---
import { ui, type Lang } from '../../i18n/ui';
import HeroScene from './HeroScene';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props as Props;
const t = ui[lang].hero;

// The badge is authored as one "·"-separated line; split it so it renders as a
// rule-separated spec line instead of a paragraph that orphans its last word.
const badgeParts = t.badge.split('·').map((part) => part.trim()).filter(Boolean);
---

<section id="hero" class="hero relative flex min-h-svh w-full items-center justify-center overflow-hidden px-[clamp(1rem,2.6vw,2rem)] pb-0 pt-16 before:pointer-events-none before:absolute before:inset-0 before:z-1 before:content-[''] before:[background:linear-gradient(180deg,rgba(12_8_20/0.28)_0%,rgba(12_8_20/0.12)_52%,rgba(12_8_20/0)_100%),radial-gradient(66%_44%_at_50%_12%,rgba(76_40_140/0.2),transparent_72%)]">
  <div class="hero-orb absolute inset-0 z-0 pointer-events-none lg:hidden" aria-hidden="true"></div>
  <HeroScene client:only="react" />
  <div class="hero-backdrop pointer-events-none absolute inset-0 z-2 [background:var(--hero-backdrop)]" aria-hidden="true"></div>
  <!-- Dissolves the particle field into the page instead of letting the hero edge cut it. -->
  <div class="hero-fade pointer-events-none absolute inset-x-0 bottom-0 z-2 h-48 [background:linear-gradient(to_bottom,transparent,var(--bg-deep))]" aria-hidden="true"></div>

  <div class="hero-content relative z-3 flex max-w-190 flex-col items-center text-center">
    <div class="hero-kicker mb-8 flex flex-col items-center gap-y-1.5 opacity-0 animate-[fade-up_0.6s_ease_forwards_0.2s] sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-4 sm:gap-y-2">
      {badgeParts.map((part, i) => (
        <>
          {i > 0 && <span class="hidden h-3.5 w-px bg-fg-muted/30 sm:block" aria-hidden="true"></span>}
          <span class="text-[0.82rem] font-medium tracking-[0.06em] text-fg-muted uppercase">{part}</span>
        </>
      ))}
    </div>

    <h1 class="hero-title mb-6 text-[clamp(3.5rem,9vw,7rem)] font-bold leading-[0.93] tracking-[-0.04em] text-fg opacity-0 animate-[fade-up_0.6s_ease_forwards_0.35s] [text-shadow:0_4px_32px_rgba(124_58_237/0.28)]">
      {t.title1}<br />
      {t.title2}
    </h1>

    <p class="hero-subtitle mb-10 max-w-160 text-[clamp(1rem,2vw,1.15rem)] leading-[1.75] text-balance text-fg-muted opacity-0 animate-[fade-up_0.6s_ease_forwards_0.5s] [text-shadow:0_1px_8px_rgba(0_0_0/0.4)]">
      {t.subtitle1}<br class="hidden sm:inline" />
      {t.subtitle2}
    </p>

    <div class="hero-actions flex flex-wrap items-center justify-center gap-4 opacity-0 animate-[fade-up_0.6s_ease_forwards_0.65s]">
      <a href="/David-Londono-Security.pdf" class="hero-cta inline-flex items-center gap-2 rounded-(--radius) bg-accent px-8 py-3.5 text-[0.95rem] font-semibold text-white no-underline shadow-[0_0_40px_var(--accent-glow)] transition-all duration-200 hover:-translate-y-0.5 hover:opacity-[0.88] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent">
        {t.ctaResume}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
        </svg>
      </a>

      <a
        href="https://github.com/davidldv"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-secondary-link inline-flex items-center gap-1.5 rounded-(--radius) border border-border bg-surface px-6 py-3.5 text-[0.95rem] font-medium text-fg-muted no-underline transition-colors duration-150 hover:border-accent hover:bg-accent-glow hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent"
        aria-label="GitHub profile"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
          />
        </svg>
        {t.github}
      </a>
    </div>

    <a
      href={`mailto:${t.ctaEmail}`}
      class="hero-email mt-6 font-mono text-[0.86rem] text-fg-muted underline decoration-fg-muted/30 underline-offset-4 opacity-0 transition-colors duration-150 animate-[fade-up_0.6s_ease_forwards_0.8s] hover:text-fg hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent"
    >
      {t.ctaEmail}
    </a>

    <div class="scroll-indicator mt-12 flex justify-center opacity-0 animate-[fade-up_0.6s_ease_forwards_1s]" aria-hidden="true">
      <span class="scroll-line block h-12 w-px [background:linear-gradient(to_bottom,var(--accent),transparent)] animate-[scroll-pulse_2s_ease-in-out_infinite]"></span>
    </div>
  </div>
</section>
