---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer/Footer.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';

const title = 'Auth & Access-Control Review · David Londoño';
const description =
  "Fixed-scope reviews of authentication and authorization. I look for the access-control bugs that reach production: alg=none, key confusion, weak secrets, broken RBAC, and the IDOR/BOLA cases where one logged-in user can read another user's data. You get a report with proof and the patch, at a fixed price and a fixed date.";

// ───────────────────────────────────────────────────────────────────
// PAYMENT: PayPal.me handle (the part after paypal.me/).
const PAYPAL_ME = 'DavidLondon427';
// ───────────────────────────────────────────────────────────────────

const pay = (amount: number) =>
  `https://www.paypal.com/paypalme/${PAYPAL_ME}/${amount}USD`;

const tiers = [
  {
    name: 'Spot Check',
    amount: 150,
    accent: 'cyan' as const,
    tagline: 'One flow, fast read',
    blurb:
      'One auth flow or endpoint, checked against the five JWT bug classes, claim hygiene, and the IDOR most likely to be sitting on that route. Small enough to find out whether the bigger engagement is worth it.',
    points: [
      '1-page findings report with severities',
      'Concrete remediation for each issue',
      '48 to 72 hour turnaround',
    ],
    cta: 'Book & pay',
  },
  {
    name: 'Auth & Access Review',
    amount: 600,
    accent: 'indigo' as const,
    featured: true,
    tagline: 'Authentication + authorization',
    blurb:
      "The whole surface: JWT, sessions, RBAC and OAuth/OIDC config, plus an IDOR/BOLA pass over your Next.js route handlers and Server Actions, looking for the spots where one user can reach another user's data.",
    points: [
      'Report: severities, PoCs, remediation, SARIF',
      'One free re-test after you patch',
      '3 to 5 day turnaround',
    ],
    cta: 'Book & pay',
  },
  {
    name: 'Review + Fix',
    amount: 1200,
    accent: 'cyan' as const,
    tagline: 'I find it and I patch it',
    blurb:
      'Everything in the Auth & Access Review, and then I write the hardening myself and hand you a pull request that is ready to merge.',
    points: [
      'Everything in the Review',
      'Merged hardening PR against your repo',
      'Re-test included',
    ],
    cta: 'Book & pay',
  },
];

const steps = [
  {
    n: '01',
    t: 'Scope in one call',
    d: 'A 15-minute call, or async if you prefer, to agree on what is in scope. Price and date are fixed from there, so there is no hourly meter running against you.',
  },
  {
    n: '02',
    t: 'I break it',
    d: 'My own tooling plus manual review: jwt-scan over your tokens, authzscan over your route handlers, and me reading the auth and access-control logic myself.',
  },
  {
    n: '03',
    t: 'You get the fix',
    d: 'A report with severities, a proof of concept and the remediation for each finding (Markdown plus SARIF for code scanning). One free re-test after you patch, so you know it is actually closed.',
  },
];

const proof = [
  {
    label: 'authzscan',
    sub: 'Automated IDOR/BOLA review for Next.js, measured against a 16-vuln benchmark with recall and precision gates',
    href: 'https://github.com/davidldv/authzscan',
  },
  {
    label: 'jwt-scan',
    sub: 'A CLI scanner for JWT misconfigurations, published on npm',
    href: 'https://www.npmjs.com/package/jwt-scan',
  },
  {
    label: 'JWT Security Lab + writeups',
    sub: 'Five JWT flaws reproduced from scratch and written up in detail',
    href: '/writeups/',
  },
];
---

<Layout title={title} description={description} canonicalPath="/services/">
  <main class="flex min-h-screen flex-col">
    <!-- Hero -->
    <section class="relative z-2 px-6 pt-24 pb-10">
      <div class="mx-auto max-w-4xl">
        <Eyebrow label="Services" class="mb-3" />
        <h1 class="mb-6 text-[clamp(2.5rem,6vw,4rem)] font-bold leading-[1] tracking-[-0.04em] text-fg">
          I find the access-control bugs that
          <span class="bg-linear-to-br from-accent to-accent-secondary bg-clip-text text-transparent">ship to prod</span>
        </h1>
        <p class="mb-8 max-w-2xl text-[1.05rem] leading-[1.7] text-fg-muted">
          <code class="font-mono text-[0.92em] text-accent">alg=none</code>, HS/RS key confusion,
          weak secrets, broken RBAC, and the one that pattern-matching scanners tend to walk past:
          <strong class="text-fg">IDOR/BOLA</strong>, where a logged-in user reaches
          <em>another user's</em> data. I go through your authentication and authorization surface,
          hand you a report with a proof of concept and the fix for each finding, and re-test after
          you patch. Fixed price, fixed date.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#book"
            data-book
            class="rounded-full bg-accent px-5 py-2.5 text-[0.9rem] font-semibold text-white transition-transform duration-150 hover:-translate-y-0.5"
          >
            Start a review
          </a>
          <a
            href="#book"
            data-book
            data-plan="Free health check"
            class="rounded-full border border-border px-5 py-2.5 text-[0.9rem] font-medium text-fg-muted transition-colors duration-150 hover:border-accent-border hover:text-fg"
          >
            Free 5-min health check
          </a>
        </div>
      </div>
    </section>

    <!-- Tiers -->
    <section class="relative z-2 px-6 py-12">
      <div class="mx-auto max-w-6xl">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {tiers.map((tier) => (
            <article
              class={`group relative flex flex-col overflow-hidden rounded-[20px] border bg-surface-elevated p-8 transition-all duration-250 hover:-translate-y-0.5 ${tier.featured ? 'border-accent-border' : 'border-border hover:border-accent-border'}`}
            >
              <div
                class={`pointer-events-none absolute inset-0 transition-opacity duration-300 ${tier.featured ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'} ${tier.accent === 'cyan' ? '[background:radial-gradient(ellipse_80%_60%_at_50%_0%,var(--accent-glow),transparent)]' : '[background:radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(94_106_210/0.12),transparent)]'}`}
              ></div>
              <div class="relative z-1 flex h-full flex-col gap-3">
                {tier.featured && (
                  <span class="mb-1 w-fit rounded-full border border-accent-border bg-surface px-2.5 py-0.5 font-mono text-[0.66rem] uppercase tracking-[0.12em] text-accent-secondary">
                    Most popular
                  </span>
                )}
                <h3 class="m-0 text-[1.2rem] font-bold tracking-[-0.02em] text-fg">{tier.name}</h3>
                <div class="flex items-baseline gap-1.5">
                  <span class="text-[2rem] font-bold tracking-[-0.03em] text-fg">${tier.amount}</span>
                  <span class="font-mono text-[0.72rem] text-fg-muted">fixed</span>
                </div>
                <p class="m-0 font-mono text-[0.8rem] font-medium text-accent">{tier.tagline}</p>
                <p class="m-0 text-[0.9rem] leading-[1.65] text-fg-muted">{tier.blurb}</p>
                <ul
                  class={`m-0 flex list-none flex-col gap-1.5 border-l-[1.5px] pl-3.5 ${tier.accent === 'cyan' ? 'border-l-cyan-400/30' : 'border-l-indigo-500/40'}`}
                >
                  {tier.points.map((p) => (
                    <li class="flex items-baseline gap-2 text-[0.82rem] leading-[1.6] text-fg-muted">
                      <span
                        class={`font-mono text-[0.72rem] ${tier.accent === 'cyan' ? 'text-accent-secondary' : 'text-accent'}`}
                        aria-hidden="true"
                      >→</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={pay(tier.amount)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`mt-auto rounded-full px-5 py-2.5 text-center text-[0.88rem] font-semibold transition-transform duration-150 hover:-translate-y-0.5 ${tier.featured ? 'bg-accent text-white' : 'border border-border text-fg hover:border-accent-border'}`}
                >
                  {tier.cta} →
                </a>
                <a
                  href="#book"
                  data-book
                  data-plan={tier.name}
                  class="text-center font-mono text-[0.7rem] text-fg-muted underline-offset-2 hover:text-accent-secondary hover:underline"
                >
                  questions first?
                </a>
              </div>
            </article>
          ))}
        </div>
        <p class="mx-auto mt-5 max-w-2xl text-center text-[0.8rem] leading-[1.6] text-fg-muted">
          Prices in USD, paid via PayPal. Remote, worldwide. Every engagement runs under a written
          scope and authorization: I only test systems you own or are authorized to test.
        </p>
      </div>
    </section>

    <!-- How it works -->
    <section class="relative z-2 px-6 py-12">
      <div class="mx-auto max-w-5xl">
        <Eyebrow label="How it works" class="mb-2" />
        <h2 class="mb-10 text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.04em] text-fg">How a review runs</h2>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {steps.map((s) => (
            <div class="rounded-[18px] border border-border bg-surface-elevated p-7">
              <span class="font-mono text-[0.9rem] font-semibold text-accent">{s.n}</span>
              <h3 class="mt-3 mb-2 text-[1.05rem] font-bold tracking-[-0.02em] text-fg">{s.t}</h3>
              <p class="m-0 text-[0.88rem] leading-[1.65] text-fg-muted">{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Proof -->
    <section class="relative z-2 px-6 py-12">
      <div class="mx-auto max-w-5xl">
        <Eyebrow label="Why me" class="mb-2" />
        <h2 class="mb-4 text-[clamp(1.8rem,4vw,2.6rem)] font-bold tracking-[-0.04em] text-fg">
          I build the tools I review with
        </h2>
        <p class="mb-8 max-w-2xl text-[0.98rem] leading-[1.7] text-fg-muted">
          I wrote two of the scanners I run. <strong class="text-fg">authzscan</strong> reads Next.js
          code and reasons about IDOR/BOLA the way pattern-matching SAST can't, and it is measured
          against a seeded benchmark with recall and precision gates. That detection logic exists
          because I reproduced every one of those bugs from scratch first. Your code gets the same
          treatment.
        </p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {proof.map((p) => (
            <a
              href={p.href}
              target={p.href.startsWith('http') ? '_blank' : null}
              rel={p.href.startsWith('http') ? 'noopener noreferrer' : null}
              class="group flex flex-col gap-1.5 rounded-[16px] border border-border bg-surface-elevated p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-border"
            >
              <span class="font-mono text-[0.9rem] font-semibold text-accent">{p.label}</span>
              <span class="text-[0.82rem] leading-[1.55] text-fg-muted">{p.sub}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Booking form (Web3Forms) -->
    <section id="book" class="relative z-2 px-6 py-16">
      <div class="mx-auto max-w-3xl rounded-[24px] border border-accent-border bg-surface-elevated p-8 sm:p-10">
        <h2 class="mb-2 text-[clamp(1.6rem,4vw,2.4rem)] font-bold tracking-[-0.03em] text-fg text-center">
          Book a review, or ask first
        </h2>
        <p class="mx-auto mb-8 max-w-xl text-center text-[0.96rem] leading-[1.65] text-fg-muted">
          Tell me about your app and I'll reply within a day. If you want a free read first, pick
          <em>Free health check</em> below and send me a token or a public repo. If you already know
          what you need, the PayPal buttons above book it right away.
        </p>

        <form
          class="flex flex-col gap-5"
          novalidate
          data-services-form
        >
          <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || 'YOUR_ACCESS_KEY_HERE'} />
          <input type="hidden" name="from_page" value="services" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label for="s-name" class="text-[0.82rem] font-medium text-fg-muted">Name</label>
              <input id="s-name" name="name" type="text" required autocomplete="name" placeholder="Your name" class="w-full rounded-[10px] border border-border bg-surface px-4 py-3 text-[0.95rem] text-fg outline-none transition-colors duration-150 placeholder:text-fg-muted/50 focus:border-accent" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="s-email" class="text-[0.82rem] font-medium text-fg-muted">Email</label>
              <input id="s-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" class="w-full rounded-[10px] border border-border bg-surface px-4 py-3 text-[0.95rem] text-fg outline-none transition-colors duration-150 placeholder:text-fg-muted/50 focus:border-accent" />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-1.5">
              <label for="s-url" class="text-[0.82rem] font-medium text-fg-muted">Project URL or repo <span class="text-fg-muted/60">(optional)</span></label>
              <input id="s-url" name="project_url" type="text" autocomplete="url" placeholder="github.com/you/app" class="w-full rounded-[10px] border border-border bg-surface px-4 py-3 text-[0.95rem] text-fg outline-none transition-colors duration-150 placeholder:text-fg-muted/50 focus:border-accent" />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="s-plan" class="text-[0.82rem] font-medium text-fg-muted">What do you need?</label>
              <select id="s-plan" name="plan" required class="w-full rounded-[10px] border border-border bg-surface px-4 py-3 text-[0.95rem] text-fg outline-none transition-colors duration-150 focus:border-accent">
                <option value="Spot Check ($150)">Spot Check · $150</option>
                <option value="Auth & Access Review ($600)" selected>Auth & Access Review · $600</option>
                <option value="Review + Fix ($1,200)">Review + Fix · $1,200</option>
                <option value="Free health check">Free 5-min health check</option>
                <option value="Not sure yet">Not sure yet, help me scope</option>
              </select>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="s-message" class="text-[0.82rem] font-medium text-fg-muted">Message</label>
            <textarea id="s-message" name="message" rows="5" required placeholder="Stack, what your auth looks like, anything you're worried about…" class="min-h-32.5 w-full resize-y rounded-[10px] border border-border bg-surface px-4 py-3 text-[0.95rem] text-fg outline-none transition-colors duration-150 placeholder:text-fg-muted/50 focus:border-accent"></textarea>
          </div>

          <button type="submit" class="inline-flex w-fit items-center gap-2 self-start rounded-full bg-accent px-7 py-3 text-[0.92rem] font-semibold text-white shadow-[0_0_30px_var(--accent-glow)] transition-all duration-200 hover:-translate-y-0.5 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent disabled:cursor-not-allowed disabled:opacity-50">
            <span class="btn-text">Send</span>
            <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 2 11 13M22 2 15 22l-4-9-9-4 20-7z"/>
            </svg>
          </button>
          <p class="m-0 text-[0.78rem] text-fg-muted" data-form-status aria-live="polite"></p>
        </form>
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<script>
  const initServicesForm = () => {
    const form = document.querySelector<HTMLFormElement>('[data-services-form]');

    // Wire "Start a review" / "questions first?" buttons to focus the form
    // and preselect the matching plan.
    document.querySelectorAll<HTMLAnchorElement>('[data-book]').forEach((el) => {
      if (el.dataset.bookBound === 'true') return;
      el.dataset.bookBound = 'true';
      el.addEventListener('click', () => {
        const wanted = el.dataset.plan;
        const select = form?.querySelector<HTMLSelectElement>('select[name="plan"]');
        if (wanted && select) {
          const match = Array.from(select.options).find((o) =>
            o.value.toLowerCase().startsWith(wanted.toLowerCase()),
          );
          if (match) select.value = match.value;
        }
        window.setTimeout(() => {
          form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus();
        }, 400);
      });
    });

    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const btnText = form.querySelector<HTMLElement>('.btn-text');
    const btnIcon = form.querySelector<SVGSVGElement>('.btn-icon');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData = new FormData(form);
      const name = String(formData.get('name') ?? '').trim();
      const plan = String(formData.get('plan') ?? '').trim();
      formData.append('subject', `New service inquiry: ${plan} (${name})`);

      const json = JSON.stringify(Object.fromEntries(formData));

      if (btnText && submitBtn && btnIcon) {
        btnText.textContent = 'Sending…';
        submitBtn.disabled = true;
        btnIcon.style.display = 'none';
      }
      if (status) status.textContent = '';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: json,
        });
        const data = await response.json();

        if (data.success) {
          form.reset();
          const select = form.querySelector<HTMLSelectElement>('select[name="plan"]');
          if (select) select.value = 'Auth & Access Review ($600)';
          if (btnText) btnText.textContent = 'Sent ✓';
          if (status) status.textContent = "Thanks, I'll reply within a day.";
          window.setTimeout(() => {
            if (btnText && submitBtn && btnIcon) {
              btnText.textContent = 'Send';
              submitBtn.disabled = false;
              btnIcon.style.display = 'block';
            }
          }, 3000);
        } else {
          throw new Error(data.message || 'Something went wrong');
        }
      } catch (error) {
        console.error(error);
        if (btnText && submitBtn && btnIcon) {
          btnText.textContent = 'Send';
          btnIcon.style.display = 'block';
          submitBtn.disabled = false;
        }
        if (status) status.textContent = 'Could not send. Email dlondon.dev@gmail.com directly.';
      }
    });
  };

  document.addEventListener('astro:page-load', initServicesForm);
  initServicesForm();
</script>

<style is:global>
  select[name='plan'] option {
    background-color: var(--bg-elevated);
    color: var(--color-fg);
  }
</style>
