---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer/Footer.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';

const title = 'David Londoño · Full-Stack Engineer mit Sicherheitsfokus';
const description =
  'Full-Stack-Entwickler aus Kolumbien: TypeScript, React, Node.js und PostgreSQL, mit Application Security als Schwerpunkt. Offen für einen Umzug nach Deutschland.';

const stats = [
  { value: '2024', label: 'Entwickler seit' },
  { value: 'Full-Stack', label: 'Mit Sicherheitsfokus' },
  { value: 'EN / DE', label: 'C1 / B1' },
  { value: 'Visa', label: 'Blue Card offen' },
];

const socials = [
  { label: 'GitHub', href: 'https://github.com/davidldv' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/davidldv' },
  { label: 'E-Mail', href: 'mailto:dlondon.dev@gmail.com' },
];

const certs = [
  { name: 'Google Professional Cybersecurity Certificate', issuer: 'Google · Coursera', status: 'completed', target: '2026', progress: 1 },
  { name: 'PortSwigger Web Security Academy', issuer: 'PortSwigger', status: 'completed', target: 'Alle kostenlosen Kurse', progress: 1 },
  { name: 'CompTIA Security+', issuer: 'CompTIA', status: 'in-progress', target: '2026 Q3', progress: 0.65 },
] as const;
const certStatus = { completed: 'Abgeschlossen', 'in-progress': 'In Bearbeitung', planned: 'Geplant' } as const;

const proofLead =
  'Der größte Teil meiner Arbeit liegt bei Auth, Sessions, Tokens und RBAC, mit den OWASP Top 10 als Checkliste. Ich greife zuerst an und repariere danach, was ich gefunden habe.';
const proofItems = [
  { title: 'JWT Security Lab', desc: 'Fünf echte JWT-Schwachstellen von Grund auf nachgebaut und dann in einer gehärteten Kopie derselben API repariert.', href: 'https://github.com/davidldv/jwtsecuritylab' },
  { title: 'jwt-scan', desc: 'Eine npm-CLI, die dieselben Bugs in Tokens und Live-Endpoints sucht. Die Exit-Codes funktionieren in CI.', href: 'https://www.npmjs.com/package/jwt-scan' },
  { title: 'Security-Writeups', desc: 'Wie die Angriffe funktionieren und wie ich sie gestoppt habe: alg=none-Bypass, HS/RS-Confusion, kid-Injection.', href: '/writeups/' },
];
---

<Layout title={title} description={description} canonicalPath="/de/">
  <main class="flex min-h-screen flex-col">
    <section class="relative z-2 px-6 pt-24 pb-16">
      <div class="mx-auto max-w-4xl">
        <nav class="mb-6 inline-flex items-center gap-1 rounded-lg border border-border p-1 text-[0.8rem] font-medium" aria-label="Sprache wählen">
          <span class="rounded-md bg-accent-glow px-2.5 py-1 text-accent" aria-current="true">DE</span>
          <a href="/" data-astro-reload class="rounded-md px-2.5 py-1 text-fg-muted no-underline transition-colors duration-150 hover:bg-surface hover:text-fg">EN</a>
          <a href="/es/" data-astro-reload class="rounded-md px-2.5 py-1 text-fg-muted no-underline transition-colors duration-150 hover:bg-surface hover:text-fg">ES</a>
        </nav>
        <h1 class="mb-6 text-[clamp(2.5rem,7vw,5rem)] font-bold leading-[0.95] tracking-[-0.04em] text-fg">
          Hallo, ich bin David.<br />
          <span class="bg-linear-to-br from-accent to-accent-secondary bg-clip-text text-transparent">
            Full-Stack Engineer.
          </span>
        </h1>
        <p class="mb-10 max-w-2xl text-[1.05rem] leading-[1.75] text-fg-muted">
          Full-Stack-Entwickler aus Pereira, Kolumbien. React, Next.js, Node,
          TypeScript und PostgreSQL, mit Application Security als Schwerpunkt.
          Offen für einen Umzug nach Deutschland.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="#ueber-mich"
            class="inline-flex items-center gap-2 rounded-(--radius) bg-accent px-6 py-3 text-[0.95rem] font-semibold text-white no-underline shadow-[0_0_30px_var(--accent-glow)] transition-all duration-200 hover:-translate-y-0.5"
          >
            Mehr über mich
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-(--radius) border border-border bg-surface px-6 py-3 text-[0.95rem] font-medium text-fg-muted no-underline transition-colors duration-150 hover:border-accent hover:text-fg"
          >
            English version
          </a>
        </div>
      </div>
    </section>

    <section class="relative z-2 px-6 pt-6 pb-2">
      <div class="mx-auto max-w-4xl rounded-[24px] border border-border bg-surface-elevated p-6 sm:p-8">
        <p class="mb-6 flex items-stretch gap-4 text-[1rem] leading-[1.7] text-fg-muted">
          <span class="w-[2px] shrink-0 bg-accent-secondary" aria-hidden="true"></span>
          <span>{proofLead}</span>
        </p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          {proofItems.map(({ title, desc, href }) => (
            <a
              href={href}
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="flex flex-col gap-2 rounded-2xl border border-border bg-surface p-5 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-border"
            >
              <h3 class="m-0 font-mono text-[0.9rem] font-semibold text-fg">{title}</h3>
              <p class="m-0 text-[0.82rem] leading-[1.6] text-fg-muted">{desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="ueber-mich" class="relative z-2 px-6 py-20">
      <div class="mx-auto max-w-4xl">
        <Eyebrow index="01" label="Über mich" class="mb-3" />
        <h2 class="mb-10 text-[clamp(2rem,5vw,3rem)] font-bold tracking-[-0.04em] text-fg">
          Wer ich bin
        </h2>

        <div class="flex flex-col gap-6 text-[1.05rem] leading-[1.8] text-fg-muted">
          <p>
            Ich baue Web-Systeme von vorne bis hinten: React und Next.js im
            Frontend, Node, TypeScript und PostgreSQL im Backend. Am meisten
            interessiert mich die Stelle, an der Code, der einwandfrei
            funktioniert, trotzdem ein Sicherheitsproblem ist.
          </p>
          <p>
            Mein aktueller Fokus: die Lücke zwischen „schnell liefern“ und „sicher
            liefern“ schließen. Das heißt Threat Modeling für Features, die ich
            selbst entwickle, die OWASP Top 10 als praktische Checkliste, und
            Angriffstechniken über TryHackMe und die PortSwigger Web Security
            Academy lernen. Gegen einen Angriff, den man nie selbst ausgeführt hat,
            verteidigt man sich schlecht.
          </p>
          <p>
            Offen für Full-Stack-, Backend- und Software-Engineer-Stellen, remote
            oder mit Umzug nach Deutschland oder in die USA.
            <strong class="text-fg">Offen für Visa-Sponsoring: Deutschland / EU Blue
            Card, USA.</strong> Spanisch Muttersprache, Englisch C1, Deutsch B1.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {stats.map(({ value, label }) => (
            <div class="flex flex-col gap-1.5 rounded-2xl border border-border bg-surface-elevated px-6 py-5">
              <span class="bg-linear-to-br from-accent to-accent-secondary bg-clip-text font-mono text-[1.5rem] font-bold tracking-[-0.04em] text-transparent">
                {value}
              </span>
              <span class="text-[0.78rem] font-medium text-fg-muted">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="zertifizierungen" class="relative z-2 px-6 py-20">
      <div class="mx-auto max-w-4xl">
        <Eyebrow index="02" label="Zertifizierungen" class="mb-3" />
        <h2 class="mb-10 text-[clamp(2rem,5vw,3rem)] font-bold tracking-[-0.04em] text-fg">
          Zertifizierungs-Fahrplan
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {certs.map((cert) => (
            <article class={`flex flex-col gap-3 rounded-2xl border bg-surface-elevated p-5 ${cert.status === 'planned' ? 'border-dashed border-border' : 'border-border'}`}>
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-surface text-accent" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                </span>
                <span class={`font-mono text-[0.72rem] ${cert.status === 'planned' ? 'text-fg-muted' : 'text-accent-secondary'}`}>
                  {certStatus[cert.status]}
                </span>
              </div>
              <div class="flex flex-col gap-1">
                <h3 class="m-0 text-[0.98rem] font-bold leading-[1.25] text-fg">{cert.name}</h3>
                <p class="m-0 font-mono text-[0.74rem] text-fg-muted">{cert.issuer}</p>
              </div>
              <div class="flex flex-col gap-2.5 pt-1">
                {cert.status === 'planned' ? (
                  <div class="h-0 w-full border-t border-dashed border-border"></div>
                ) : (
                  <div class="h-[3px] w-full bg-border">
                    <div class="h-full bg-accent-secondary" style={`width:${Math.round(cert.progress * 100)}%`}></div>
                  </div>
                )}
                <p class="m-0 font-mono text-[0.72rem]"><span class="text-fg-muted">{cert.status === 'completed' ? 'Abgeschlossen' : 'Ziel'}:</span> <span class="text-accent">{cert.target}</span></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="relative z-2 px-6 py-20">
      <div class="mx-auto max-w-4xl">
        <Eyebrow index="03" label="Kontakt" class="mb-3" />
        <h2 class="mb-6 text-[clamp(2rem,5vw,3rem)] font-bold tracking-[-0.04em] text-fg">
          Lass uns sprechen
        </h2>
        <p class="mb-8 max-w-2xl text-[1.05rem] leading-[1.7] text-fg-muted">
          Wenn Sie jemanden suchen, der beim Bauen schon an die Angriffsseite denkt,
          oder ein Projekt haben, das sich lohnt: schreiben Sie mir.
        </p>
        <ul class="m-0 flex flex-wrap gap-3 p-0" role="list">
          {socials.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface-elevated px-5 py-3 text-fg-muted no-underline transition-colors duration-150 hover:border-accent-border hover:text-fg"
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
